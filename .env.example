# Copy to .env.local for local development.

# Neon (serverless Postgres) connection string.
# Use the pooled (-pooler) connection string for serverless/production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the admin session cookie (JWT). Generate with: openssl rand -base64 48
JWT_SECRET=

# Single admin account, created by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Vercel Blob token for shop photo uploads (vercel blob store).
BLOB_READ_WRITE_TOKEN=

# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Overpass API endpoint. A mirror can be swapped in here.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# How far the OSM import searches for shops, in km (Abeokuta-wide by default).
OSM_SYNC_RADIUS_KM=25

# Used in the Overpass User-Agent (Overpass etiquette requires a contact).
CONTACT_EMAIL=hello@example.com

# Bearer token required by GET /api/cron/sync (Vercel Cron).
CRON_SECRET=

# Show the 5 sample shops (demo only — set to false before launch).
SHOW_SAMPLES=false

# Local-only escape hatch: use the embedded PGlite database (.data/gentry)
# even for a production build. Never set this on Vercel.
ALLOW_EMBEDDED_DB=false
